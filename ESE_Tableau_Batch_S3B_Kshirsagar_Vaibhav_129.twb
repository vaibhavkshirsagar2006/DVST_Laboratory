          <datasources>
            <datasource caption='spotify_history' name='federated.0p4kit318fymdb17d97ac0m8d4u2' />
          </datasources>
          <datasource-dependencies datasource='federated.0p4kit318fymdb17d97ac0m8d4u2'>
