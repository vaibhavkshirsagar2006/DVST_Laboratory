      <table>
        <view>
          <datasources>
            <datasource caption='spotify_history' name='federated.0p4kit318fymdb17d97ac0m8d4u2' />
          </datasources>
          <datasource-dependencies datasource='federated.0p4kit318fymdb17d97ac0m8d4u2'>
            <column caption='Ms Played' datatype='integer' name='[ms_played]' role='measure' type='quantitative' />
            <column-instance column='[track_name]' derivation='None' name='[none:track_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[ms_played]' derivation='Sum' name='[sum:ms_played:qk]' pivot='key' type='quantitative' />
            <column caption='Track Name' datatype='string' name='[track_name]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0p4kit318fymdb17d97ac0m8d4u2].[none:track_name:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
